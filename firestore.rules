rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A profile is readable/writable only by its owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Trip helpers ----
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Which fields changed in this update? (Only the touched keys, not the whole doc.)
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Fields every member may edit together (wishlist, votes, calendars, comfort…).
    // Anything NOT on this list (ownerUid, memberUids, joinCode, name, type) is owner-only or locked.
    function collabFields() {
      return ['items','proposals','itinerary','moments','busy','prefs','finders','deals','feed','updatedAt'];
    }
    function newMembers() { return request.resource.data.memberUids; }
    function oldMembers() { return resource.data.memberUids; }

    // Owner: may edit anything EXCEPT ownerUid (ownership never transfers), and must stay a member.
    function isOwnerUpdate() {
      return resource.data.ownerUid == me()
        && !changed().hasAny(['ownerUid'])
        && newMembers() is list && me() in newMembers();
    }
    // Member (not owner): collaborative fields only.
    function isMemberCollabUpdate() {
      return me() in oldMembers() && changed().hasOnly(collabFields());
    }
    // Member (not owner) leaving: remove exactly yourself, touch nothing else.
    function isLeave() {
      return me() in oldMembers() && me() != resource.data.ownerUid
        && changed().hasOnly(['memberUids'])
        && newMembers() is list
        && newMembers().toSet() == oldMembers().toSet().difference([me()].toSet())
        && newMembers().size() == oldMembers().size() - 1;
    }
    // Joining with an invite: add exactly yourself, and name a real invite code for THIS trip.
    function isJoinWithInvite(tripId) {
      return !(me() in oldMembers())
        && changed().hasOnly(['memberUids','joinCode'])
        && request.resource.data.get('joinCode', null) is string
        && newMembers() is list
        && newMembers().toSet() == oldMembers().toSet().union([me()].toSet())
        && newMembers().size() == oldMembers().size() + 1
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.tripId == tripId;
    }

    // Invite-only trips: no listing / no public discovery. Members only.
    match /trips/{tripId} {
      allow get: if signedIn() && me() in resource.data.memberUids;
      allow list: if false;
      // A new trip starts with just its owner; others join via invite.
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()];
      allow update: if signedIn()
        && (isOwnerUpdate() || isMemberCollabUpdate() || isLeave() || isJoinWithInvite(tripId));
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /comments/{id} {
        allow read, create: if signedIn()
          && me() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
        allow update, delete: if signedIn() && resource.data.authorUid == me();
      }
      match /activity/{id} {
        allow read: if signedIn()
          && me() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
        allow create: if signedIn()
          && me() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
        allow update, delete: if false;
      }
    }

    // Invite codes: fetchable only by exact code (no listing).
    match /invites/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }
  }
}
